# Backend settings. Outside production, a missing backend/.env is created
# from this file. All lines are commented out; uncomment what you need.

# JWT_SECRET=replace-with-32-plus-random-characters
# CORS_ORIGINS=https://example.com
# FRONTEND_URL=https://example.com
# APP_NAME=vegas-buddy
# TRUST_PROXY=1

# Optional Stripe (the app is free)
# STRIPE_KEY=
# STRIPE_ENDPOINT_SECRET=
